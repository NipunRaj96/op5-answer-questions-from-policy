# Copy to .env and fill in. .env is git-ignored. The file is sourced by a shell: quote JSON.
# All recorded runs: generator qwen/qwen3.8-27b and judge openai/gpt-oss-20b, both on Groq.
GROQ_API_KEY=
LLM_API_KEY=${GROQ_API_KEY}
GEN_MODEL=qwen/qwen3.8-27b
GEN_EXTRA='{"reasoning_effort":"low"}'
JUDGE_MODEL=openai/gpt-oss-20b

# Direct to the provider:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# Rate-limited tier: run `scripts/reproduce.sh proxy` in another terminal and route through it.
UPSTREAM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=http://127.0.0.1:4010
LLM_TIMEOUT=300
EVAL_CONCURRENCY=1
